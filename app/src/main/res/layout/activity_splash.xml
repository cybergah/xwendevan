<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/stamp_bg"
            android:contentDescription="@string/app_name"
            android:padding="14dp"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.04"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.75"
            android:gravity="center"
            android:text="@string/splash_tagline"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <!-- ses dalgası -->
        <LinearLayout
            android:id="@+id/bars"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View style="@style/SplashBar" />

            <View style="@style/SplashBar" />

            <View style="@style/SplashBar" />

            <View style="@style/SplashBar" />

            <View style="@style/SplashBar" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="42dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:alpha="0.75"
            android:contentDescription="@string/about_cybergah_title"
            android:src="@drawable/cybergah_logo"
            app:tint="@color/cybergah_red" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.7"
            android:text="@string/by_cybergah"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />
    </LinearLayout>
</FrameLayout>
