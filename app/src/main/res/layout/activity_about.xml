<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/menu_about" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/stamp_bg"
                android:contentDescription="@string/app_name"
                android:padding="10dp"
                android:src="@drawable/ic_launcher_foreground" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" />

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/by_cybergah"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/cybergah_red" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/about_text"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            <TextView
                style="@style/AboutSection"
                android:text="@string/about_use_title" />

            <TextView
                style="@style/AboutBody"
                android:text="@string/about_use" />

            <TextView
                style="@style/AboutSection"
                android:text="@string/about_speak_title" />

            <TextView
                style="@style/AboutBody"
                android:text="@string/about_speak" />

            <TextView
                style="@style/AboutSection"
                android:text="@string/about_voices_title" />

            <TextView
                android:id="@+id/voiceList"
                style="@style/AboutBody" />

            <TextView
                style="@style/AboutSection"
                android:text="@string/about_privacy_title" />

            <TextView
                style="@style/AboutBody"
                android:text="@string/about_privacy" />

            <!-- Cybergah künyesi -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cybergahCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/stamp_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="24dp">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:contentDescription="@string/about_cybergah_title"
                        android:src="@drawable/cybergah_logo" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:alpha="0.92"
                        android:gravity="center"
                        android:text="@string/cybergah_slogan"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:alpha="0.88"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.25"
                        android:text="@string/about_cybergah"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:alpha="0.8"
                        android:gravity="center"
                        android:text="@string/cybergah_note"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/cybergahUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/badge_bg"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/cybergah_url_label"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/AboutSection"
                android:text="@string/about_engine_title" />

            <TextView
                style="@style/AboutBody"
                android:text="@string/about_engine" />

            <TextView
                style="@style/AboutSection"
                android:text="@string/about_license_title" />

            <TextView
                style="@style/AboutBody"
                android:text="@string/about_license" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
